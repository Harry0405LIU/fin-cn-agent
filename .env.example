# Fin-Agent 环境变量配置模板
#
# 推荐把密钥放到「项目文件夹之外」，避免误提交到 GitHub：
#   cp .env.example ~/.finagent.env
#   编辑 ~/.finagent.env 填入你的真实值
#
# 代码会按以下优先级自动加载（先找到的优先）：
#   1. FINAGENT_ENV_FILE 指定的路径
#   2. ~/.finagent.env（推荐）
#   3. ~/.config/fin-agent/.env
#   4. 项目根目录 .env

# ---- LLM Provider (至少配置一个，首选 z.ai) ----
# z.ai / Anthropic（推荐首选）
# ANTHROPIC_AUTH_TOKEN=your_token_here
# ANTHROPIC_BASE_URL=https://api.z.ai/api/anthropic
# Anthropic 官方 API Key
# ANTHROPIC_API_KEY=sk-ant-...
# DeepSeek API Key
# DEEPSEEK_API_KEY=sk-...
# 智谱 GLM API Key
# GLM_API_KEY=your_glm_key_here
# OpenAI API Key
# OPENAI_API_KEY=sk-...

# ---- 数据源 ----
# iTick API Key (https://itick.io) - 推荐配置
ITICK_API_KEY=your_itick_api_key_here

# Longport OpenAPI (https://longportapp.com)
# LONGPORT_APP_KEY=your_app_key_here
# LONGPORT_APP_SECRET=your_app_secret_here
# LONGPORT_ACCESS_TOKEN=your_access_token_here

# ---- 通知推送 (可选) ----
# 企业微信 Webhook URL
# FINAGENT_WEBHOOK_URL=https://qyapi.weixin.qq.com/cgi-bin/webhook/send?key=xxx
# 兼容旧变量名
# ELLIOTT_WEBHOOK_URL=https://qyapi.weixin.qq.com/cgi-bin/webhook/send?key=xxx

# ---- 系统配置 (可选) ----
# 日志级别: DEBUG/INFO/WARNING/ERROR
# FINAGENT_LOG_LEVEL=INFO

# 数据获取超时时间（秒）
# FINAGENT_DATA_TIMEOUT=30

# 重试次数
# FINAGENT_DATA_RETRIES=3

# 请求频率限制（秒）
# FINAGENT_RATE_LIMIT=0.5

# 缓存过期天数
# FINAGENT_CACHE_EXPIRE_DAYS=7
